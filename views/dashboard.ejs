<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body,
        html {
            min-height: 100vh;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #134e4a 0%, #065f46 100%);
            color: #fdfbf7;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        /* Ana Konteyner - Yan yana 3 sütun sığması için genişletildi */
        .welcome-container {
            width: 100%;
            max-width: 900px;
            /* Ekranı daha geniş yaptık */
            background: #ffffff;
            border-radius: 24px;
            padding: 45px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            text-align: center;
            border: 1px solid #f0ede6;
            color: #1f2937;
        }

        /* Üst Header Alanı */
        .header-section {
            margin-bottom: 30px;
        }

        .static-icon {
            font-size: 2.8rem;
            margin-bottom: 10px;
        }

        .header-section h1 {
            color: #065f46;
            font-size: 2.2rem;
            font-weight: 700;
        }

        /* Etkinlikler Grid - Tam 3 Sütun Düzeni */
        .activities-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            /* Tam 3 eşit sütun */
            gap: 20px;
            margin-bottom: 35px;
            text-align: left;
        }

        .activity-card {
            background-color: #f9f8f6;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 20px;
            text-decoration: none;
            color: #1f2937;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .activity-card:hover {
            transform: translateY(-4px);
            border-color: #34d399;
            box-shadow: 0 8px 20px rgba(6, 95, 70, 0.1);
        }

        .activity-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #065f46;
            margin-bottom: 8px;
        }

        .activity-date {
            font-size: 0.85rem;
            color: #6b7280;
        }

        /* Etkinlik Olmadığında Görünecek Kutu */
        .no-activity {
            background-color: #f9f8f6;
            border: 2px dashed #a7f3d0;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 30px;
            color: #047857;
            font-size: 1rem;
            font-weight: 500;
        }

        /* Buton Grubu ve Stili */
        .btn-group {
            display: flex;
            justify-content: center;
        }

        .btn {
            display: inline-block;
            padding: 14px 32px;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-secondary {
            background: linear-gradient(45deg, #065f46, #047857);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(6, 95, 70, 0.2);
        }

        .btn-secondary:hover {
            opacity: 0.95;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(6, 95, 70, 0.3);
        }

        /* Mobil Cihazlar İçin Uyumluluk */
        @media (max-width: 768px) {
            .activities-grid {
                grid-template-columns: 1fr;
                /* Mobilde tek sütuna düşsün */
            }

            .welcome-container {
                padding: 30px 20px;
            }
        }

        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <div class="welcome-container">
        <div class="header-section">
            <div class="static-icon">✨</div>
            <h1>Hoş geldin, <%= user.username %>!</h1>
        </div>

        <!-- Etkinlik Kontrolü ve Döngüsü (Esnetilmiş isimlerle) -->
        <% if (activities && activities.length> 0) { %>
            <div class="activities-grid">
                <% activities.forEach(activity=> { %>
                    <a href="/activity/<%= activity.id %>" class="activity-card">
                        <div class="activity-title">
                            <%= activity.activityName || activity.name || activity.title || 'İsimsiz Etkinlik' %>
                        </div>
                        <div class="activity-date">
                            <%= activity.activityDate || activity.date || activity.created_at || '' %>
                        </div>
                    </a>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="no-activity">Henüz kayıtlı bir etkinliğin bulunmuyor.</div>
                <% } %>

                    <div class="btn-group">
                        <a href="/panel" class="btn btn-secondary">Tüm Etkinliklerim</a>
                    </div>
    </div>

</body>

</html>