<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik'e Giriş Yap</title>
    <script src="/theme.js"></script>
    <!-- Google Fonts ve Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        /* Genel Sayfa ve Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body,
        html {
            height: 100%;
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
        }

        /* Ana İki Sütunlu Konteyner */
        .login-split-container {
            display: flex;
            width: 100vw;
            min-height: 100vh;
        }

        /* Sol Taraf: Mint Yeşili ve Krem Tonları */
        .login-left-panel {
            flex: none;
            width: 60%;
            background: linear-gradient(135deg, #134e4a 0%, #065f46 100%);
            color: #fdfbf7;
            position: relative;
            box-sizing: border-box;
        }

        .left-panel-content {
            position: sticky;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            box-sizing: border-box;
        }

        /* Marka Başlığı */
        .brand-header {
            display: flex;
            align-items: center;
            margin-bottom: 60px;
        }

        .logo-icon {
            font-size: 2.5rem;
            margin-right: 15px;
        }

        .brand-header h1 {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 3px;
            color: #6ee7b7;
            margin: 0;
            text-transform: uppercase;
        }

        /* Büyük Hero Metni */
        .hero-text-wrapper {
            line-height: 1.1;
            margin-bottom: 30px;
        }

        .hero-line {
            font-size: 4rem;
            font-weight: 800;
            color: #fdfbf7;
        }

        .hero-line.highlight-green {
            color: #34d399;
        }

        .hero-line.highlight-blue {
            color: #a7f3d0;
        }

        .hero-subtext {
            font-size: 1.2rem;
            color: #a7f3d0;
            max-width: 500px;
            font-weight: 300;
        }

        /* Sağ Taraf: Login/Register Kartı (Krem Arka Plan) */
        .login-right-panel {
            flex: none;
            width: 40%;
            background-color: #f9f8f6;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .login-card {
            width: 100%;
            max-width: 450px;
            background: #ffffff;
            padding: 40px 50px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(6, 95, 70, 0.08);
            border: 1px solid #f0ede6;
        }

        .login-card h2 {
            text-align: center;
            color: #065f46;
            margin-bottom: 30px;
            font-size: 2rem;
            font-weight: 700;
        }

        /* Giriş Formu Elemanları */
        .input-group {
            margin-bottom: 18px;
        }

        .input-group label {
            display: block;
            margin-bottom: 6px;
            color: #374151;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .input-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 0.95rem;
            font-family: 'Poppins', sans-serif;
            outline: none;
            transition: border-color 0.2s;
            box-sizing: border-box;
            background-color: #fcfbf9;
        }

        .input-group input:focus {
            border-color: #059669;
            background-color: #ffffff;
        }

        /* Buton */
        .btn-login {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, #065f46, #047857);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            margin-top: 10px;
        }

        .btn-login:hover {
            opacity: 0.95;
        }

        .btn-login:active {
            transform: scale(0.98);
        }

        /* Alt Linkler */
        .login-links {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        .login-links a {
            text-decoration: none;
            font-weight: 500;
        }

        .register-link {
            color: #059669;
            font-weight: 700;
        }

        .register-link:hover {
            text-decoration: underline;
        }

        .forgot-password-link {
            color: #6b7280;
            font-size: 0.85rem;
        }

        .forgot-password-link:hover {
            text-decoration: underline;
        }

        /* Mobil Uyumluluk */
        @media (max-width: 992px) {
            .login-split-container {
                flex-direction: column;
                height: auto;
                overflow: auto;
            }

            .login-left-panel {
                flex: none !important;
                width: 100% !important;
                height: auto !important;
            }
            
            .left-panel-content {
                position: static;
                height: auto;
                padding: 40px 20px !important;
                text-align: center;
                align-items: center;
            }

            .brand-header {
                margin-bottom: 20px;
            }

            .hero-line {
                font-size: 2.5rem;
            }

            .login-right-panel {
                flex: none !important;
                width: 100% !important;
                padding: 20px;
            }

            .login-card {
                box-shadow: none;
                padding: 30px;
            }
        }
    
    /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
    @media (max-width: 768px) {
        /* Konteynerlar */
        .container, .main-container, .panel-container, .content-container, .form-container, .card, .profile-container, .settings-container {
            width: 95% !important;
            max-width: 100% !important;
            padding: 15px !important;
            margin: 10px auto !important;
            box-sizing: border-box !important;
            box-shadow: none !important;
        }

        /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
        .flex-row, .activities-grid, .list-item, .expense-item, .payment-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 10px !important;
            width: 100% !important;
            height: auto !important;
        }

        

        /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
        input, select, textarea, .btn, .btn-primary, .btn-danger, .btn-secondary {
            width: 100% !important;
            font-size: 16px !important; 
            margin-top: 5px !important;
            margin-bottom: 5px !important;
            box-sizing: border-box !important;
            
        }

        /* Modallar (Acilir Pencereler) */
        .modal-content, #expenseModal > div, #editExpenseModal > div {
            width: 95% !important;
            margin: 20px auto !important;
            padding: 20px !important;
            height: auto !important;
            max-height: 90vh !important;
            overflow-y: auto !important;
        }

        /* Baslik Boyutlari */
        h1, h2 {
            font-size: 1.4rem !important;
            text-align: center !important;
        }
        h3 {
            font-size: 1.2rem !important;
        }

        /* Tablolar (Tasan tablolari kaydirilabilir yap) */
        table {
            display: block !important;
            overflow-x: auto !important;
            white-space: nowrap !important;
            width: 100% !important;
        }
    }

</style>
</head>

<body>


    <div class="login-split-container">
        <!-- Sol Taraf -->
        <div class="login-left-panel">
            <div class="left-panel-content">
                <div class="brand-header">
                    <div class="logo-icon">✨</div>
                    <h1>HESAPMATİK</h1>
                </div>
                <div class="hero-text-wrapper">
                    <p class="hero-line">Alacak</p>
                    <p class="hero-line highlight-green">verecek</p>
                    <p class="hero-line">takibinin</p>
                    <p class="hero-line highlight-blue">en akıllı yolu</p>
                </div>
                <p class="hero-subtext">Finansal dengenizi saniyeler içinde kontrol altına alın.</p>
            </div>
        </div>

        <!-- Sağ Taraf (Giriş Yapma Formu) -->
        <div class="login-right-panel">
            <div class="login-card">

                <% if (typeof logoutSuccess !== 'undefined' && logoutSuccess) { %>
                    <!-- BAŞARI: Çıkış Yapıldı -->
                    <div style="text-align:center; background:#ecfdf5; border:1px solid #a7f3d0; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                        <h3 style="color: #059669; margin-bottom: 5px; font-size:1.1rem;">✅ Çıkış Başarılı</h3>
                        <p style="color: #065f46; font-size: 0.85rem;">Hesabınızdan başarıyla çıkış yapılmıştır.</p>
                    </div>
                <% } %>

                <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                    <div style="text-align:center; background:#ecfdf5; border:1px solid #a7f3d0; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                        <h3 style="color: #059669; margin-bottom: 5px; font-size:1.1rem;">✅ Başarılı</h3>
                        <p style="color: #065f46; font-size: 0.85rem;"><%= successMessage %></p>
                    </div>
                <% } %>

                <% if (typeof reactivateSuccess !== 'undefined' && reactivateSuccess) { %>
                    <!-- BAŞARI: Hesap Aktifleştirildi -->
                    <div style="text-align:center; background:#ecfdf5; border:1px solid #a7f3d0; padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                        <h3 style="color: #059669; margin-bottom: 5px; font-size:1.1rem;">✅ Hesabınız aktifleştirilmiştir!</h3>
                        <p style="color: #065f46; font-size: 0.85rem;">Şimdi hesabınıza giriş yapabilirsiniz.</p>
                    </div>
                <% } %>

                <% if (typeof reactivateStep !== 'undefined' && reactivateStep==='otp' ) { %>
                        <!-- ADIM 2: OTP Kodu Girme -->
                        <h2>Aktivasyon Kodu</h2>
                        <p style="color:#6b7280; font-size:0.85rem; margin: 8px 0 20px;">E-posta adresinize gönderilen 6
                            haneli kodu girin.</p>
                        <% if (typeof reactivateError !== 'undefined' && reactivateError==='wrong_otp' ) { %>
                            <div
                                style="background:#fef2f2; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:0.85rem; margin-bottom:14px; border:1px solid #fecaca;">
                                ❌ Girdiğiniz kod hatalı. Lütfen tekrar deneyin.
                            </div>
                            <% } %>
                                <form action="/reactivate/verify" method="POST">
                                    <div class="input-group">
                                        <label>Aktivasyon Kodu</label>
                                        <input type="text" name="otpInput" placeholder="123456" maxlength="6" required
                                            style="font-size:1.5rem; letter-spacing:8px; text-align:center;" autofocus>
                                    </div>
                                    <button type="submit" class="btn-login">Hesabı Aktifleştir</button>
                                </form>
                                <div style="text-align:center; margin-top:16px;">
                                    <a href="/login?passive=1" style="color:#6b7280; font-size:0.8rem;">← Geri dön</a>
                                </div>

                                <% } else if (typeof passive !== 'undefined' && passive) { %>
                                    <!-- ADIM 1: Pasif Hesap Uyarısı + E-posta Formu -->
                                    <h2>Hesap Pasif</h2>
                                    <div
                                        style="background:#fef2f2; color:#dc2626; padding:12px 16px; border-radius:8px; font-size:0.85rem; margin: 12px 0 20px; border:1px solid #fecaca;">
                                        ⚠️ Bu hesap pasif durumda olduğu için giriş yapılamaz.
                                    </div>
                                    <p style="color:#374151; font-size:0.9rem; margin-bottom:20px;">Hesabınızı yeniden
                                        aktifleştirmek için kayıtlı e-posta adresinizi girin. Size bir aktivasyon kodu
                                        göndereceğiz.</p>
                                    <% if (typeof reactivateError !== 'undefined' && reactivateError==='email_not_found' ) { %>
                                        <div
                                            style="background:#fef2f2; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:0.85rem; margin-bottom:14px; border:1px solid #fecaca;">
                                            ❌ Bu e-posta adresiyle eşleşen pasif bir hesap bulunamadı.
                                        </div>
                                        <% } %>
                                            <form action="/reactivate" method="POST">
                                                <div class="input-group">
                                                    <label>Kayıtlı E-posta Adresiniz</label>
                                                    <input type="email" name="email" placeholder="ornek@email.com"
                                                        required autofocus>
                                                </div>
                                                <button type="submit" class="btn-login">Aktivasyon Kodu Gönder</button>
                                            </form>
                                            <div style="text-align:center; margin-top:16px;">
                                                <a href="/login" style="color:#6b7280; font-size:0.8rem;">← Normal giriş
                                                    için geri dön</a>
                                            </div>

                                            <% } else { %>
                                                <!-- NORMAL GİRİŞ FORMU -->
                                                <h2>Giriş Yap</h2>
                                                <% if (typeof reactivateError !== 'undefined' && reactivateError==='wrong' ) { %>
                                                    <div
                                                        style="background:#fef2f2; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:0.85rem; margin-bottom:14px; border:1px solid #fecaca;">
                                                        ❌ Giriş bilgileri veya şifre hatalı.
                                                    </div>
                                                <% } else if (typeof reactivateError !== 'undefined' && reactivateError==='passive_wrong' ) { %>
                                                    <div
                                                        style="background:#fef2f2; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:0.85rem; margin-bottom:14px; border:1px solid #fecaca;">
                                                        ❌ Kullanıcı adı veya şifre hatalı. Hesabınız pasif durumda olabilir, aktifleştirmek için <a href="/login?passive=1" style="color:#b91c1c; text-decoration:underline; font-weight:600;">buraya tıklayın</a>.
                                                    </div>
                                                <% } %>
                                                        <form action="/login" method="POST">
                                                            <div class="input-group">
                                                                <label>Kullanıcı Adı, E-posta veya Telefon</label>
                                                                <input type="text" name="username"
                                                                    placeholder="Giriş bilginizi yazın" required>
                                                            </div>

                                                            <div class="input-group">
                                                                <label>Şifre</label>
                                                                <input type="password" name="password"
                                                                    placeholder="Şifrenizi girin" required>
                                                            </div>

                                                            <button type="submit" class="btn-login">Giriş Yap</button>
                                                        </form>

                                                        <div class="login-links">
                                                            <a href="/forgot-password"
                                                                class="forgot-password-link">Şifremi Unuttum</a>
                                                            <div>
                                                                <span style="color: #6b7280; margin-right: 5px;">Hesabın
                                                                    yok mu?</span>
                                                                <a href="/register" class="register-link">Kayıt Ol</a>
                                                            </div>
                                                        </div>
                                                        <% } %>

            </div>
        </div>
    </div>

</body>

</html>