<!DOCTYPE html>
<html lang="tr">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <title>Profil ve Kullanıcı Adı</title>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>

    <style>
        /* Mevcut Hesabı Sil yazısını buton gibi göstermek için */
        .delete-link-btn {
            background: none;
            border: none;
            color: #dc2626 !important;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            text-decoration: underline;
            display: block;
            margin: 20px auto 0 auto;
            text-align: center;
            transition: opacity 0.2s;
        }

        .delete-link-btn:hover {
            opacity: 0.8;
        }

        /* Modal Arka Planı (Karartma) */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            backdrop-filter: blur(4px);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        /* Modal Kutusu */
        .modal-card {
            background: #f4f3ef !important;
            border: 1px solid rgba(24, 78, 61, 0.12);
            border-radius: 16px;
            padding: 24px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            transform: scale(0.95);
            transition: transform 0.3s ease;
        }

        .modal-overlay.active .modal-card {
            transform: scale(1);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 800;
            color: #184e3d !important;
            margin-bottom: 10px;
        }

        .modal-desc {
            font-size: 14px;
            color: #2e6b56 !important;
            line-height: 1.5;
            margin-bottom: 24px;
        }

        /* Modal Butonları */
        .modal-actions {
            display: flex;
            gap: 12px;
        }

        .modal-btn {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            border: none;
            transition: background-color 0.2s;
            text-align: center;
        }

        .cancel-btn {
            background-color: transparent;
            color: #184e3d !important;
            border: 1px solid rgba(24, 78, 61, 0.3);
        }

        .cancel-btn:hover {
            background-color: rgba(24, 78, 61, 0.05);
        }

        .confirm-delete-btn {
            background-color: #dc2626 !important;
            color: white !important;
            width: 100%;
        }

        .confirm-delete-btn:hover {
            background-color: #b91c1c !important;
        }

        body {
            background-color: #e8e6e1;
            font-family: sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .card {
            background: #f7f6f2;
            padding: 30px;
            border-radius: 20px;
            width: 380px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .back-btn {
            text-decoration: none;
            color: #333;
            font-size: 20px;
            position: absolute;
            top: 20px;
            left: 20px;
        }

        .title {
            text-align: center;
            color: #0d2b22;
            font-size: 22px;
            margin-top: 10px;
            margin-bottom: 20px;
        }

        .avatar-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 2px solid #0d2b22;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-sizing: border-box;
            outline: none;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background-color: #0d2b22;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-delete {
            display: block;
            text-align: center;
            color: #d9534f;
            text-decoration: none;
            font-weight: bold;
            margin-top: 15px;
            font-size: 14px;
        }



        .modal-content {
            background: #ffffff;
            padding: 25px;
            border-radius: 15px;
            width: 320px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
        }

        .modal-content h3 {
            margin-top: 0;
            color: #0d2b22;
        }

        .otp-input {
            letter-spacing: 4px;
            font-size: 20px !important;
            text-align: center;
            margin-top: 10px;
        }

        .error-msg {
            color: #d9534f;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .main-delete-btn {
            width: 100%;
            padding: 12px;
            background-color: rgba(220, 38, 38, 0.08);
            color: #dc2626 !important;
            border: 1px solid rgba(220, 38, 38, 0.2);
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            font-size: 14px;
            transition: background-color 0.2s;
            display: block;
            text-align: center;
        }

        .main-delete-btn:hover {
            background-color: rgba(220, 38, 38, 0.15);
        }

        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <div class="card">
        <a href="/profile" class="back-btn">←</a>
        <h2 class="title">Profil ve Kullanıcı Adı</h2>

        <div class="avatar-container" style="cursor: pointer;" onclick="document.getElementById('avatarInput').click()">
            <div class="avatar-circle" id="avatarPreview" style="overflow: hidden; position: relative;">
                <% if (user.avatar) { %>
                    <img src="<%= user.avatar %>" alt="Profil Fotoğrafı"
                        style="width: 100%; height: 100%; object-fit: cover;">
                    <% } else { %>
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="#4a2e80">
                            <path
                                d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </svg>
                        <% } %>
                            <div
                                style="position: absolute; bottom: 0; background: rgba(0,0,0,0.5); width: 100%; text-align: center; color: white; font-size: 10px; padding: 2px 0;">
                                Değiştir</div>
            </div>
        </div>

        <form action="/profile/edit" method="POST" enctype="multipart/form-data">
            <input type="file" name="avatar" id="avatarInput" accept="image/*" style="display: none;"
                onchange="previewAvatar(event)">
            <div class="form-group">
                <label for="username">Kullanıcı Adı <span
                        style="font-size: 11px; color: #888; font-weight: normal;">(değiştirilemez)</span></label>
                <input type="text" id="username" name="username" value="<%= user.username || '' %>" readonly
                    style="background: #f3f4f6; cursor: not-allowed; color: #6b7280; border-color: #d1d5db;">
            </div>

            <div class="form-group">
                <label for="email">E-Posta Adresi <span
                        style="font-size: 11px; color: #888; font-weight: normal;">(değiştirilemez)</span></label>
                <input type="email" id="email" name="email" value="<%= user.email || '' %>" readonly
                    style="background: #f3f4f6; cursor: not-allowed; color: #6b7280; border-color: #d1d5db;">
            </div>

            <div class="form-group">
                <label for="phone">Telefon Numarası</label>
                <input type="text" id="phone" name="phone" value="<%= user.phone || '' %>" placeholder="05XX XXX XX XX"
                    maxlength="11" pattern="^0[0-9]{10}$" title="Telefon numarası 0 ile başlamalı ve 11 hane olmalıdır"
                    oninput="validatePhone(this)">
                <div id="phoneWarning" style="color: #d9534f; font-size: 12px; margin-top: 5px; display: none;"></div>
            </div>

            <button type="submit" class="btn-submit">Kaydet</button>
        </form>
        <button type="button" onclick="openDeleteModal()" class="main-delete-btn">Hesabı Pasif Et</button>

    </div>

    <!-- ONAY KODU POPUP (Sadece E-posta veya Telefon değiştiğinde ekrana gelir) -->
    <% if (typeof showOtpModal !=='undefined' && showOtpModal) { %>
        <div class="modal-overlay active">
            <div class="modal-content">
                <h3>Güvenlik Doğrulaması</h3>
                <p style="font-size: 13px; color: #555; margin-bottom: 15px;">
                    E-posta veya telefon değişikliğini tamamlamak için e-postanıza gelen 6 haneli onay kodunu
                    giriniz.
                </p>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-msg">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/profile/verify-otp" method="POST">
                            <div class="form-group">
                                <input type="text" name="otpInput" class="otp-input" placeholder="123456" maxlength="6"
                                    required autofocus>
                            </div>
                            <button type="submit" class="btn-submit">Doğrula ve Güncelle</button>
                        </form>
            </div>
        </div>
        <% } %>
            <!-- Hesap Pasife Alma Onay Modali -->
            <div class="modal-overlay" id="deleteModal" style="display: none;">
                <div class="modal-card">
                    <h3 class="modal-title">Hesabı Pasif Et</h3>
                    <p class="modal-desc">Hesabınızı pasif duruma getirmek istediğinize emin misiniz? Bu işlem
                        sonrasında giriş yapamayacaksınız ancak bilgileriniz korunacaktır.</p>

                    <div class="modal-actions">
                        <button type="button" class="modal-btn cancel-btn" onclick="closeDeleteModal()">İptal</button>

                        <!-- Gerçek silme işlemini yapacak form ve doğru submit butonu -->
                        <form action="/profile/delete" method="POST" style="flex: 1; margin: 0;">
                            <button type="submit" class="modal-btn confirm-delete-btn">Hesabı Pasif Et</button>
                        </form>
                    </div>
                </div>
            </div>

</body>
<script>
    function previewAvatar(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const previewContainer = document.getElementById('avatarPreview');
                previewContainer.innerHTML = `
                    <img src="${e.target.result}" alt="Yeni Profil" style="width: 100%; height: 100%; object-fit: cover;">
                    <div style="position: absolute; bottom: 0; background: rgba(0,0,0,0.5); width: 100%; text-align: center; color: white; font-size: 10px; padding: 2px 0;">Değiştir</div>
                `;
            };
            reader.readAsDataURL(file);
        }
    }

    function openDeleteModal() {
        const modal = document.getElementById('deleteModal');
        if (modal) {
            modal.style.display = 'flex';
            modal.classList.add('active');
        }
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('active');
        }
    }

    function validatePhone(input) {
        const warning = document.getElementById('phoneWarning');
        const val = input.value;
        let warningText = "";

        if (/[^0-9]/.test(val)) {
            warningText = "Sadece rakam girebilirsiniz.";
        } else if (val.length > 0 && val[0] !== '0') {
            warningText = "Telefon numarası 0 ile başlamalıdır.";
        } else if (val.length === 11 && !/^0[0-9]{10}$/.test(val)) {
            warningText = "Telefon numarası geçerli değil.";
        }

        if (warningText) {
            warning.style.display = 'block';
            warning.textContent = warningText;
        } else {
            warning.style.display = 'none';
        }
    }

    function checkPhoneLength(e) {
        if (e.target.value.length >= 11) {
            const warning = document.getElementById('phoneWarning');
            warning.style.display = 'block';
            warning.textContent = "En fazla 11 hane girebilirsiniz.";
            clearTimeout(window.phoneWarningTimeout);
            window.phoneWarningTimeout = setTimeout(() => { warning.style.display = 'none'; }, 3000);
        }
    }

    // Modal dışına tıklandığında kapanması için
    window.onclick = function (event) {
        const modal = document.getElementById('deleteModal');
        if (event.target === modal) {
            closeDeleteModal();
        }
    }
</script>

</html>