<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mahsuplaşma Raporu: <%= activityName %> - Hesapmatik</title>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: #e8e7e1 !important;
            color: #0f382c !important;
            padding-bottom: 90px;
            min-height: 100vh;
            font-weight: 400;
        }

        /* Üst Temiz Header */
        .header-section {
            background: #f4f3ef;
            border-bottom: 1px solid rgba(15, 56, 44, 0.08);
            padding: 16px 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            margin-bottom: 25px;
        }

        .header-content {
            max-width: 960px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .back-btn {
            background: rgba(15, 56, 44, 0.08);
            color: #0f382c;
            border: 1px solid rgba(15, 56, 44, 0.12);
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 500;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .back-btn:hover {
            background: rgba(15, 56, 44, 0.15);
        }

        .closed-badge {
            background: #d1f4e0;
            color: #0f382c;
            padding: 5px 13px;
            border-radius: 20px;
            font-weight: 500;
            font-size: 12px;
            border: 1px solid #7ce3b1;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .main-container {
            max-width: 960px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Koyu Yeşil Rapor Bannerı */
        .closed-hero-card {
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%);
            color: #ffffff;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 25px;
            box-shadow: 0 10px 25px rgba(15, 56, 44, 0.2);
            position: relative;
            overflow: hidden;
        }

        .closed-hero-card::after {
            content: "🔒";
            position: absolute;
            right: 20px;
            bottom: -10px;
            font-size: 90px;
            opacity: 0.12;
            pointer-events: none;
        }

        /* Renkli Özet Kutuları */
        .summary-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
            gap: 16px;
            margin-bottom: 25px;
        }

        .summary-card {
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.02);
        }

        .summary-card.yellow {
            background: #fff8bf;
            border: 1px solid #f7e26b;
        }

        .summary-card.blue {
            background: #d0ebff;
            border: 1px solid #74c0fc;
        }

        .summary-card.green {
            background: #d1f4e0;
            border: 1px solid #7ce3b1;
        }

        .summary-card-title {
            font-size: 11px;
            font-weight: 500;
            color: #537066;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-bottom: 6px;
        }

        .summary-card-value {
            font-size: 21px;
            font-weight: 600;
            color: #0f382c;
            letter-spacing: -0.3px;
        }

        .section-card {
            background: #ffffff;
            border: 1px solid rgba(15, 56, 44, 0.08);
            border-radius: 20px;
            padding: 22px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.02);
            margin-bottom: 25px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #0f382c;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .participant-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #fdfbf7;
            border: 1px solid rgba(15, 56, 44, 0.08);
            border-radius: 12px;
            margin-bottom: 10px;
        }

        .expense-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #fdfbf7;
            border: 1px solid rgba(15, 56, 44, 0.08);
            border-radius: 12px;
            margin-bottom: 10px;
        }

        .payment-history-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #fdfbf7;
            border: 1px solid rgba(15, 56, 44, 0.08);
            border-radius: 12px;
            margin-bottom: 10px;
        }

        /* Üst Banner / Hero Header (Full Width Curved) */
        .settlement-hero {
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%);
            color: #ffffff;
            padding: 12px 20px;
            margin-bottom: 18px;
            width: 100%;
            border-radius: 0 0 16px 16px;
            box-shadow: 0 6px 20px rgba(15, 56, 44, 0.12);
            position: relative;
            overflow: visible !important;
        }

        /* Alt Navigasyon Barı (Dark Green Gradient Theme - Full Width Curved) */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%) !important;
            color: #ffffff !important;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 10px 0;
            border-radius: 16px 16px 0 0;
            box-shadow: 0 -6px 20px rgba(15, 56, 44, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            z-index: 1000;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: rgba(255, 255, 255, 0.65) !important;
            text-decoration: none;
            font-size: 10.5px;
            font-weight: 500;
            gap: 2px;
            transition: all 0.2s ease;
        }

        .nav-item i,
        .nav-item svg {
            font-size: 18px !important;
            width: 18px !important;
            height: 18px !important;
            max-width: 18px !important;
            max-height: 18px !important;
        }

        .nav-item:hover,
        .nav-item.active {
            color: #ffffff !important;
            font-weight: 700;
            transform: translateY(-1px);
        }
    </style>
</head>

<body>

    <!-- Header Hero Banner (Settlement Style) -->
    <div class="settlement-hero">
        <div
            style="max-width: 960px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 14px;">
                <% if (typeof activity !=='undefined' && activity.coverImage) { %>
                    <img src="<%= activity.coverImage %>" alt="Kapak"
                        style="width: 50px; height: 50px; border-radius: 12px; object-fit: cover; border: 1.5px solid rgba(255,255,255,0.25); box-shadow: 0 4px 10px rgba(0,0,0,0.12);">
                    <% } else { %>
                        <div
                            style="width: 50px; height: 50px; border-radius: 12px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            🔒
                        </div>
                        <% } %>
                            <div>
                                <div
                                    style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.12); color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 500; border: 1px solid rgba(255, 255, 255, 0.18); margin-bottom: 4px;">
                                    <i class="fas fa-lock" style="font-size: 10px; color: #10b981;"></i> Mahsuplaşma
                                    Kapatıldı & Tamamlandı
                                </div>
                                <h1
                                    style="font-size: 19px; font-weight: 600; margin: 0; color: #ffffff; letter-spacing: -0.2px;">
                                    <%= activityName %>
                                </h1>
                            </div>
            </div>

            <div>
                <a href="/panel"
                    style="color: rgba(255,255,255,0.9); text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.18); transition: all 0.2s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.22)'"
                    onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                    <i class="fas fa-arrow-left" style="font-size: 11px;"></i> Panele Dön
                </a>
            </div>
        </div>
    </div>

    <div class="main-container">

        <!-- Koyu Yeşil Rapor Bannerı -->
        <div class="closed-hero-card">
            <h1 style="font-size: 20px; font-weight: 600; margin-bottom: 6px; color: #ffffff;">
                <%= activityName %> - Mahsuplaşma Raporu
            </h1>
            <p style="font-size: 13.5px; color: rgba(255,255,255,0.9); line-height: 1.5; font-weight: 400;">
                🎉 Bu etkinliğin mahsuplaşması tamamlandı ve hesaplar kapatıldı. Tüm katılımcılar borçlarını ödedi.
                Aşağıdan etkinlikte yapılan tüm harcamaları ve hesap detaylarını inceleyebilirsiniz.
            </p>
        </div>

        <% let totalExpenses=(allExpenses || []).reduce((sum, exp)=> sum + (Number(exp.amount) || 0), 0);
            let numParticipants = Array.isArray(participants) ? participants.length : 0;
            let perPersonShare = numParticipants > 0 ? (totalExpenses / numParticipants) : 0;
            %>

            <!-- Renkli Özet Kutuları -->
            <div class="summary-cards-grid">
                <div class="summary-card yellow">
                    <div class="summary-card-title">Toplam Etkinlik Harcaması</div>
                    <div class="summary-card-value">
                        ₺<%= totalExpenses.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2
                            }) %>
                    </div>
                </div>
                <div class="summary-card blue">
                    <div class="summary-card-title">Kişi Başı Düşen Pay</div>
                    <div class="summary-card-value">
                        ₺<%= perPersonShare.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2
                            }) %>
                    </div>
                </div>
                <div class="summary-card green">
                    <div class="summary-card-title">Hesap Durumu</div>
                    <div class="summary-card-value"
                        style="font-size: 15px; font-weight: 500; display: flex; align-items: center; gap: 6px; color: #0f382c;">
                        <i class="fas fa-check-circle" style="color: #10b981;"></i> Tamamen Kapandı
                    </div>
                </div>
            </div>

            <!-- Katılımcı Harcama Dağılımı -->
            <div class="section-card">
                <div class="section-title">
                    👥 Katılımcı Harcama Özetleri
                </div>
                <% if (participants && participants.length> 0) { %>
                    <% participants.forEach(p=> {
                        let userExpenses = (allExpenses || []).filter(exp => String(exp.userId) ===
                        String(p.id)).reduce((sum, exp) => sum + (Number(exp.amount) || 0), 0);
                        %>
                        <div class="participant-row">
                            <div>
                                <span style="font-weight: 500; font-size: 13.5px; color: #0f382c;">
                                    <%= p.fullname %>
                                </span>
                                <span style="font-size: 11.5px; color: #537066; margin-left: 6px; font-weight: 400;">(@
                                    <%= p.username %>)</span>
                            </div>
                            <div style="text-align: right;">
                                <span style="font-weight: 600; font-size: 14px; color: #0f382c;">
                                    ₺<%= userExpenses.toLocaleString('tr-TR', { minimumFractionDigits: 2,
                                        maximumFractionDigits: 2 }) %>
                                </span>
                                <span style="font-size: 11px; display: block; color: #10b981; font-weight: 500;">
                                    ✓ Borcu Kalmadı
                                </span>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
            </div>

            <!-- Yapılan Harcamaların Detay Listesi -->
            <div class="section-card">
                <div class="section-title">
                    🧾 Etkinlik Harcamaları Listesi (Nereye Ne Harcandı?)
                </div>
                <% if (allExpenses && allExpenses.length> 0) { %>
                    <% allExpenses.forEach(exp=> {
                        let spender = (participants || []).find(p => String(p.id) === String(exp.userId));
                        let spenderName = spender ? spender.fullname : 'Katılımcı';
                        %>
                        <div class="expense-item-row">
                            <div>
                                <div style="font-weight: 500; font-size: 14px; color: #0f382c;">
                                    <%= exp.expenseName %>
                                </div>
                                <div style="font-size: 11.5px; color: #537066; margin-top: 2px; font-weight: 400;">
                                    Harcayan: <strong>
                                        <%= spenderName %>
                                    </strong>
                                </div>
                            </div>
                            <div style="text-align: right; display: flex; align-items: center; gap: 12px;">
                                <span style="font-weight: 600; font-size: 15px; color: #0f382c;">
                                    ₺<%= Number(exp.amount).toLocaleString('tr-TR', { minimumFractionDigits: 2,
                                        maximumFractionDigits: 2 }) %>
                                </span>
                                <% if (exp.receipt) { %>
                                    <a href="/uploads/<%= exp.receipt %>" target="_blank" title="Fiş / Makbuz Gör"
                                        style="color: #0f382c; font-size: 14px;">
                                        <i class="fas fa-file-invoice"></i>
                                    </a>
                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div
                                    style="text-align: center; color: #537066; padding: 20px; font-weight: 400; font-size: 13.5px;">
                                    Etkinlikte kayıtlı harcama bulunmuyor.
                                </div>
                                <% } %>
            </div>

            <!-- Ödeme Hareketleri Geçmişi -->
            <div class="section-card">
                <div class="section-title">
                    💳 Tamamlanan Elden / Transfer Ödemeleri
                </div>
                <% if (payments && payments.length> 0) { %>
                    <% payments.forEach(p=> { %>
                        <div class="payment-history-row">
                            <div>
                                <div style="font-weight: 500; font-size: 13.5px; color: #0f382c;">
                                    <%= p.senderName %> &rarr; <%= p.receiverName %>
                                </div>
                                <div style="font-size: 11.5px; color: #537066; margin-top: 2px; font-weight: 400;">
                                    <%= p.description || 'Grup mahsuplaşma ödemesi' %>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-weight: 600; font-size: 14.5px; color: #0f382c;">
                                    ₺<%= Number(p.amount).toLocaleString('tr-TR', { minimumFractionDigits: 2,
                                        maximumFractionDigits: 2 }) %>
                                </div>
                                <span style="font-size: 11px; color: #10b981; font-weight: 500;">
                                    ✓ Onaylandı
                                </span>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div
                                    style="text-align: center; color: #537066; padding: 20px; font-weight: 400; font-size: 13.5px;">
                                    Elden yapılmış ödeme hareketi bulunmuyor.
                                </div>
                                <% } %>
            </div>

    </div>

    <!-- Alt Navigasyon Menüsü -->
    <nav class="bottom-nav">
        <a href="/panel" class="nav-item active">
            <i class="fas fa-folder-open"></i>
            <span>Etkinlikler</span>
        </a>
        <a href="/profile" class="nav-item">
            <i class="fas fa-user"></i>
            <span>Profil</span>
        </a>
    </nav>

</body>

</html>