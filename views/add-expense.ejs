<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Harcama Ekle</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #e8e7e1 !important;
            color: #0f382c !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: #f4f3ef;
            padding: 32px 28px;
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 10px 25px rgba(15, 56, 44, 0.06);
            border: 1px solid rgba(15, 56, 44, 0.12);
        }

        h2 {
            font-size: 22px;
            font-weight: 800;
            color: #0f382c;
            margin-bottom: 24px;
            text-align: left;
        }

        .amount-display {
            border: 2px solid #0f382c;
            border-radius: 14px;
            padding: 16px;
            text-align: right;
            font-size: 32px;
            font-weight: 800;
            color: #0f382c;
            margin-bottom: 16px;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .amount-display:hover {
            border-color: #175241;
            background: #fafaf8;
        }

        .form-group {
            margin-bottom: 16px;
        }

        input[type="text"], input[type="file"] {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid rgba(15, 56, 44, 0.2);
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            outline: none;
            color: #0f382c;
            background: #ffffff;
            transition: border-color 0.2s ease;
        }

        input[type="text"]:focus {
            border-color: #0f382c;
        }

        /* Dosya Seçme Butonu Şablonu */
        input[type="file"] {
            padding: 8px 12px;
            font-size: 13px;
            color: #537066;
            cursor: pointer;
        }

        /* Dosya Listesi Alanı */
        .file-list {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .file-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ffffff;
            border: 1px solid rgba(15, 56, 44, 0.15);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #0f382c;
        }

        .file-item button {
            background: #fee2e2;
            color: #ef4444;
            border: none;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease;
        }

        .file-item button:hover {
            background: #fca5a5;
        }

        /* Özel Klavye (Tuş Takımı) */
        .keypad {
            display: none;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 16px;
            margin-bottom: 8px;
        }

        .keypad.show {
            display: grid;
        }

        .key-btn {
            background: #ffffff;
            border: 1.5px solid rgba(15, 56, 44, 0.15);
            border-radius: 12px;
            padding: 14px;
            font-size: 20px;
            font-weight: 700;
            color: #0f382c;
            cursor: pointer;
            transition: all 0.1s ease;
            text-align: center;
        }

        .key-btn:active {
            background: #e8e7e1;
            transform: scale(0.98);
        }

        .btn-submit {
            width: 100%;
            background: rgba(15, 56, 44, 0.3);
            color: #ffffff;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 15px;
            cursor: not-allowed;
            margin-top: 16px;
            transition: all 0.2s ease;
        }

        .btn-submit.active {
            background: #0f382c;
            color: #f4f3ef;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(15, 56, 44, 0.15);
        }

        .btn-submit.active:hover {
            background: #175241;
        }
    </style>
</head>
<body>

<div class="card">
    <h2>Harcama Ekle</h2>
    
    <form action="/add-expense" method="POST" enctype="multipart/form-data">

        <input type="hidden" name="activityId" value="<%= typeof activityId !== 'undefined' ? activityId : '' %>">
        
        <!-- Miktar Göstergesi -->
        <div class="amount-display" id="amountDisplay">0,00</div>
        <input type="hidden" name="amount" id="amountInput" value="0">

        <!-- Harcama Adı -->
        <div class="form-group">
            <input type="text" name="expenseName" required placeholder="Harcama Adı: Örn. market, benzin, otopark vb">
        </div>

        <!-- Fiş veya Dekont Yükle (Çoklu Seçim Özellikli) -->
        <div class="form-group">
            <input type="file" name="receipt" id="receiptInput" multiple>
            <div class="file-list" id="fileList"></div>
        </div>

        <!-- Özel Klavye (Tuş Takımı) -->
        <div class="keypad" id="keypad">
            <button type="button" class="key-btn" onclick="pressKey('1')">1</button>
            <button type="button" class="key-btn" onclick="pressKey('2')">2</button>
            <button type="button" class="key-btn" onclick="pressKey('3')">3</button>
            <button type="button" class="key-btn" onclick="pressKey('4')">4</button>
            <button type="button" class="key-btn" onclick="pressKey('5')">5</button>
            <button type="button" class="key-btn" onclick="pressKey('6')">6</button>
            <button type="button" class="key-btn" onclick="pressKey('7')">7</button>
            <button type="button" class="key-btn" onclick="pressKey('8')">8</button>
            <button type="button" class="key-btn" onclick="pressKey('9')">9</button>
            <div></div>
            <button type="button" class="key-btn" onclick="pressKey('0')">0</button>
            <button type="button" class="key-btn" onclick="deleteKey()">⌫</button>
        </div>

        <!-- Harcama Ekle Butonu -->
        <button type="submit" class="btn-submit" id="submitBtn">Harcama Ekle</button>
    </form>
</div>

<script>
    let currentAmount = "0";
    const amountDisplay = document.getElementById('amountDisplay');
    const keypad = document.getElementById('keypad');
    const receiptInput = document.getElementById('receiptInput');
    const fileListContainer = document.getElementById('fileList');
    
    let selectedFiles = []; // Seçilen dosyaları hafızada tutacağız

    // Kuturaya tıklandığında tuş takımını göster
    amountDisplay.addEventListener('click', function() {
        keypad.style.setProperty('display', 'grid', 'important');
    });

    // Dosya seçildiğinde listeye ekle
    receiptInput.addEventListener('change', function(e) {
        const files = Array.from(e.target.files);
        files.forEach(file => {
            selectedFiles.push(file);
        });
        updateFileList();
    });

    // Listeden belirli bir dosyayı silme
    function removeFile(index) {
        selectedFiles.splice(index, 1);
        updateFileList();
    }

    // Dosya listesini ekranda güncelle ve inputa yansıt
    function updateFileList() {
        fileListContainer.innerHTML = '';
        
        // DataTransfer kullanarak inputun içindeki dosyaları güncelliyoruz
        const dataTransfer = new DataTransfer();
        
        selectedFiles.forEach((file, index) => {
            dataTransfer.items.add(file);

            const fileItem = document.createElement('div');
            fileItem.className = 'file-item';
            fileItem.innerHTML = `
                <span>${file.name}</span>
                <button type="button" onclick="removeFile(${index})">×</button>
            `;
            fileListContainer.appendChild(fileItem);
        });

        receiptInput.files = dataTransfer.files;
    }

    // Bilgisayar klavyesinden tuş basıldığında algıla
    document.addEventListener('keydown', function(event) {
        if (document.activeElement.tagName === 'INPUT' && document.activeElement.type === 'text') {
            return;
        }

        if (event.key >= '0' && event.key <= '9') {
            pressKey(event.key);
        } else if (event.key === 'Backspace') {
            deleteKey();
        }
    });

    function pressKey(num) {
        if (currentAmount === "0") {
            currentAmount = num;
        } else {
            currentAmount += num;
        }
        updateDisplay();
    }

    function deleteKey() {
        if (currentAmount.length > 1) {
            currentAmount = currentAmount.slice(0, -1);
        } else {
            currentAmount = "0";
        }
        updateDisplay();
    }

    function updateDisplay() {
        let displayVal = (parseInt(currentAmount) / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2 });
        amountDisplay.innerText = displayVal;
        document.getElementById('amountInput').value = (parseInt(currentAmount) / 100).toFixed(2);
        
        const submitBtn = document.getElementById('submitBtn');
        if (parseInt(currentAmount) > 0) {
            submitBtn.classList.add('active');
        } else {
            submitBtn.classList.remove('active');
        }
    }
</script>

</body>
</html>