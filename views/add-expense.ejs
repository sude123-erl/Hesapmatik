<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Harcama Ekle</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f4f6f9; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .card { background: #ffffff; padding: 30px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); width: 100%; max-width: 400px; }
        h2 { margin-bottom: 20px; color: #2c3e50; font-size: 20px; }
        
        .amount-display {
            border: 2px solid #d946ef;
            border-radius: 12px;
            padding: 15px;
            text-align: right;
            font-size: 28px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 15px;
            background: #fff;
            cursor: pointer;
        }
        
        .form-group { margin-bottom: 15px; }
        input[type="text"], input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
        }
        input:focus { border-color: #2c3e50; }

        /* Dosya Listesi Alanı */
        .file-list {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .file-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            color: #475569;
        }
        .file-item button {
            background: #fee2e2;
            color: #ef4444;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Özel Klavye (Tuş Takımı) */
        .keypad {
            display: none;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 15px;
        }
        .keypad.show {
            display: grid;
        }

        .key-btn {
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px;
            font-size: 20px;
            font-weight: 600;
            color: #2c3e50;
            cursor: pointer;
            transition: 0.1s;
            text-align: center;
        }
        .key-btn:active { background: #f1f5f9; }

        .btn-submit {
            width: 100%;
            background: #e2e8f0;
            color: #475569;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.2s;
        }
        .btn-submit.active {
            background: #2c3e50;
            color: white;
        }
    </style>
</head>
<body>
<div class="card">
        <h2>Harcama Ekle</h2>
        
        <form action="/add-expense" method="POST" enctype="multipart/form-data">

            <input type="hidden" name="activityId" value="<%= typeof activityId !== 'undefined' ? activityId : '' %>">
             <!-- Miktar Göstergesi -->
            <div class="amount-display" id="amountDisplay">0,00</div>
            <input type="hidden" name="amount" id="amountInput" value="0">

            <!-- Harcama Adı -->
            <div class="form-group">
                <input type="text" name="expenseName" required placeholder="Harcama Adı: Örn. market, benzin, otopark vb">
            </div>

            <!-- Fiş veya Dekont Yükle (Çoklu Seçim Özellikli) -->
            <div class="form-group">
                <input type="file" name="receipt" id="receiptInput" multiple>
                <div class="file-list" id="fileList"></div>
            </div>

            <!-- Özel Klavye (Tuş Takımı) -->
            <div class="keypad" id="keypad">
                <button type="button" class="key-btn" onclick="pressKey('1')">1</button>
                <button type="button" class="key-btn" onclick="pressKey('2')">2</button>
                <button type="button" class="key-btn" onclick="pressKey('3')">3</button>
                <button type="button" class="key-btn" onclick="pressKey('4')">4</button>
                <button type="button" class="key-btn" onclick="pressKey('5')">5</button>
                <button type="button" class="key-btn" onclick="pressKey('6')">6</button>
                <button type="button" class="key-btn" onclick="pressKey('7')">7</button>
                <button type="button" class="key-btn" onclick="pressKey('8')">8</button>
                <button type="button" class="key-btn" onclick="pressKey('9')">9</button>
                <div></div>
                <button type="button" class="key-btn" onclick="pressKey('0')">0</button>
                <button type="button" class="key-btn" onclick="deleteKey()">⌫</button>
            </div>

            <!-- Harcama Ekle Butonu -->
          <button type="submit" class="btn-submit" id="submitBtn">Harcama Ekle</button>
        </form>
    </div>

    <script>
        let currentAmount = "0";
        const amountDisplay = document.getElementById('amountDisplay');
        const keypad = document.getElementById('keypad');
        const receiptInput = document.getElementById('receiptInput');
        const fileListContainer = document.getElementById('fileList');
        
        let selectedFiles = []; // Seçilen dosyaları hafızada tutacağız

        // Pembe kutuya tıklandığında tuş takımını göster
        amountDisplay.addEventListener('click', function() {
            keypad.style.setProperty('display', 'grid', 'important');
        });

        // Dosya seçildiğinde listeye ekle
        receiptInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            files.forEach(file => {
                selectedFiles.push(file);
            });
            updateFileList();
        });

        // Listeden belirli bir dosyayı silme
        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateFileList();
        }

        // Dosya listesini ekranda güncelle ve inputa yansıt
        function updateFileList() {
            fileListContainer.innerHTML = '';
            
            // DataTransfer kullanarak inputun içindeki dosyaları güncelliyoruz
            const dataTransfer = new DataTransfer();
            
            selectedFiles.forEach((file, index) => {
                dataTransfer.items.add(file);

                const fileItem = document.createElement('div');
                fileItem.className = 'file-item';
                fileItem.innerHTML = `
                    <span>${file.name}</span>
                    <button type="button" onclick="removeFile(${index})">×</button>
                `;
                fileListContainer.appendChild(fileItem);
            });

            receiptInput.files = dataTransfer.files;
        }

        // Bilgisayar klavyesinden tuş basıldığında algıla
        document.addEventListener('keydown', function(event) {
            if (document.activeElement.tagName === 'INPUT' && document.activeElement.type === 'text') {
                return;
            }

            if (event.key >= '0' && event.key <= '9') {
                pressKey(event.key);
            } else if (event.key === 'Backspace') {
                deleteKey();
            }
        });

        function pressKey(num) {
            if (currentAmount === "0") {
                currentAmount = num;
            } else {
                currentAmount += num;
            }
            updateDisplay();
        }

        function deleteKey() {
            if (currentAmount.length > 1) {
                currentAmount = currentAmount.slice(0, -1);
            } else {
                currentAmount = "0";
            }
            updateDisplay();
        }

        function updateDisplay() {
            let displayVal = (parseInt(currentAmount) / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2 });
            amountDisplay.innerText = displayVal;
            document.getElementById('amountInput').value = (parseInt(currentAmount) / 100).toFixed(2);
            
            const submitBtn = document.getElementById('submitBtn');
            if (parseInt(currentAmount) > 0) {
                submitBtn.classList.add('active');
            } else {
                submitBtn.classList.remove('active');
            }
        }
    </script>

</body>
</html>