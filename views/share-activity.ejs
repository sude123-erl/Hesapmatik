<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Etkinliği Paylaş</title>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #e8e7e1 !important;
            color: #0f382c !important;
            min-height: 100vh;
            padding-bottom: 110px !important;
        }

        /* Alt Navigasyon Barı (Dark Green Gradient Theme - Full Width Curved) */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%) !important;
            color: #ffffff !important;
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 10px 0;
            border-radius: 16px 16px 0 0;
            box-shadow: 0 -6px 20px rgba(15, 56, 44, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            z-index: 1000;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.65) !important;
            font-size: 10.5px;
            font-weight: 500;
            gap: 2px;
            transition: all 0.2s ease;
        }

        .nav-item:hover,
        .nav-item.active {
            color: #ffffff !important;
            font-weight: 700;
            opacity: 1 !important;
            transform: translateY(-1px);
        }

        .nav-item i,
        .nav-item svg {
            font-size: 18px !important;
            width: 18px !important;
            height: 18px !important;
            max-width: 18px !important;
            max-height: 18px !important;
            display: block !important;
            fill: currentColor !important;
            color: inherit !important;
            margin-bottom: 2px !important;
        }

        .settlement-hero {
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%);
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 0 0 16px 16px;
            box-shadow: 0 6px 20px rgba(15, 56, 44, 0.12);
            margin-bottom: 18px;
            position: relative;
            overflow: visible !important;
        }

        .card {
            background: #f4f3ef;
            padding: 28px 24px;
            border-radius: 20px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 25px rgba(15, 56, 44, 0.06);
            border: 1px solid rgba(15, 56, 44, 0.12);
            text-align: center;
        }

        /* En Üstteki Etkinlik Adı Kutusu */
        .activity-header-box {
            background: rgba(15, 56, 44, 0.08);
            color: #0f382c;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        h2 {
            font-size: 18px;
            font-weight: 700;
            color: #0f382c;
            margin-bottom: 16px;
        }

        /* QR Kod Kutusu */
        .qr-container {
            background: #ffffff;
            border: 1.5px solid rgba(15, 56, 44, 0.15);
            border-radius: 16px;
            padding: 20px;
            display: inline-block;
            margin-bottom: 20px;
        }

        .qr-container img {
            max-width: 180px;
            height: auto;
            display: block;
        }

        /* Paylaş Butonu */
        .btn-share {
            width: 100%;
            padding: 12px;
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .btn-share:hover {
            background: #175241;
        }

        /* Geri Dön Linki */
        .back-link {
            display: inline-block;
            margin-top: 10px;
            margin-bottom: 20px;
            color: #0f382c;
            font-size: 13px;
            font-weight: 600;
            text-decoration: underline;
            cursor: pointer;
        }

        .divider {
            height: 1px;
            background: rgba(15, 56, 44, 0.12);
            margin-bottom: 20px;
        }

        /* Katılımcılar Başlığı ve Rozeti */
        .participants-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .participants-header span {
            font-size: 15px;
            font-weight: 700;
            color: #0f382c;
        }

        .badge-count {
            background: rgba(15, 56, 44, 0.1);
            color: #0f382c;
            font-size: 12px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 12px;
        }

        /* Katılımcı Satırı */
        .participant-box {
            background: #ffffff;
            border: 1px solid rgba(15, 56, 44, 0.15);
            padding: 10px 14px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            margin-bottom: 12px;
            color: #0f382c;
        }

        .participant-role {
            font-size: 12px;
            color: #537066;
        }

        /* Katılımcı Ekle Formu */
        .add-form {
            display: flex;
            gap: 8px;
        }

        .select-participant {
            flex: 1;
            padding: 10px 12px;
            border: 1.5px solid rgba(15, 56, 44, 0.2);
            border-radius: 10px;
            font-size: 13px;
            color: #0f382c;
            background: #ffffff;
            outline: none;
        }

        .btn-add {
            padding: 10px 16px;
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-remind {
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 8px;
            padding: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .btn-remind:hover {
            background: #175241;
        }

        .btn-remove {
            background: #fee2e2;
            color: #ef4444;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .btn-remove:hover {
            background: #fca5a5;
            color: #b91c1c;
        }

        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <!-- Header Hero Banner (Settlement Style) -->
    <div class="settlement-hero">
        <div
            style="max-width: 960px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 14px;">
                <% if (typeof activity !=='undefined' && activity.coverImage) { %>
                    <img src="<%= activity.coverImage %>" alt="Kapak"
                        style="width: 50px; height: 50px; border-radius: 12px; object-fit: cover; border: 1.5px solid rgba(255,255,255,0.25);">
                    <% } else { %>
                        <div
                            style="width: 50px; height: 50px; border-radius: 12px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            👥
                        </div>
                        <% } %>
                            <div>
                                <div
                                    style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.12); color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 500; border: 1px solid rgba(255, 255, 255, 0.18); margin-bottom: 4px;">
                                    <span
                                        style="width: 7px; height: 7px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
                                    Katılımcı Yönetimi & Paylaşım
                                </div>
                                <h1
                                    style="font-size: 19px; font-weight: 600; margin: 0; color: #ffffff; letter-spacing: -0.2px;">
                                    <%= typeof activity !=='undefined' ? (activity.activityName || activity.name)
                                        : 'Etkinlik' %>
                                </h1>
                            </div>
            </div>

            <div>
                <a href="/panel"
                    style="color: rgba(255,255,255,0.9); text-decoration: none; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.18); transition: all 0.2s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.22)'"
                    onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                    <i class="fas fa-arrow-left" style="font-size: 11px;"></i> Panele Dön
                </a>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: center; padding: 0 15px;">
        <div class="card">
            <!-- Etkinlik Adı Kutusu -->
            <div class="activity-header-box">
                <%= typeof activity !=='undefined' ? activity.name : 'Ankara' %>
            </div>

            <h2>Etkinliği Paylaş</h2>

            <% let isSettlementPhase = (typeof activity !== 'undefined' && activity.isClosed !== null && activity.isClosed !== undefined && Number(activity.isClosed) >= 1); %>
            
            <% if (isSettlementPhase) { %>
                <div style="background: #fffbe6; border: 1px solid #ffe58f; border-radius: 14px; padding: 16px; margin-bottom: 20px; font-size: 13.5px; color: #856404; font-weight: 500; text-align: center;">
                    <i class="fas fa-lock" style="color: #d97706; margin-right: 6px;"></i>
                    Mahsuplaşma aşamasına geçildiği için yeni katılımcı ekleme ve çıkarma kapatılmıştır.
                </div>
            <% } else if (isOwner) { %>
                <!-- QR Kod -->
                <div class="qr-container">
                    <img src="<%= typeof qrCodeUrl !== 'undefined' ? qrCodeUrl : '/path-to-qr.png' %>" alt="QR Kod">
                </div>

                <!-- Paylaşım Butonu -->
                <button class="btn-share" onclick="copyShareLink()">Linki Kopyala ve Paylaş</button>
            <% } else { %>
                <div style="background: rgba(15, 56, 44, 0.05); padding: 15px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; color: #537066;">
                    Yalnızca etkinlik sahibi yeni kişileri davet edebilir.
                </div>
            <% } %>

                        <div class="divider" style="margin-top: 20px;"></div>

                        <!-- Katılımcılar Alanı -->
                        <div class="participants-header">
                            <span>Katılımcılar</span>
                            <span class="badge-count">
                                <%= participants ? participants.length : 0 %> kişi
                            </span>
                        </div>

                        <% if (participants && participants.length> 0) { %>
                            <% participants.forEach(p=> { %>
                                <div class="participant-box">
                                    <div>
                                        <span style="font-weight: 600;">
                                            <%= p.fullname || p.username %>
                                        </span>
                                        <% if (String(activity.creatorId)===String(p.id)) { %>
                                            <span class="participant-role" style="display:block;">Etkinlik sahibi</span>
                                            <% } %>
                                    </div>
                                    <div style="display: flex; gap: 6px;">
                                        <% if (typeof currentUserId !=='undefined' && currentUserId &&
                                            String(currentUserId) !==String(p.id)) { %>
                                            <!-- Hatırlat Butonu -->
                                            <form action="/notify-debt" method="POST" style="margin: 0;"
                                                onsubmit="sendReminder(event, this)">
                                                <input type="hidden" name="targetUserId" value="<%= p.id %>">
                                                <input type="hidden" name="activityName"
                                                    value="<%= activity.activityName %>">
                                                <input type="hidden" name="activityId" value="<%= activity.id %>">
                                                <button type="submit" title="Hatırlat" class="btn-remind">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                            <% } %>

                                                <% if (String(activity.creatorId) !==String(p.id) && isOwner &&
                                                    !isLocked) { %>
                                                    <!-- Çıkar Butonu -->
                                                    <form
                                                        action="/activity/<%= activity.id %>/participants/<%= p.id %>/remove"
                                                        method="POST" style="margin: 0;"
                                                        onsubmit="customConfirm(event, this, 'Bu kişiyi çıkarmak istediğinize emin misiniz?');">
                                                        <button type="submit" title="Çıkar" class="btn-remove">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                height="16" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M3 6h18" />
                                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                                <line x1="10" x2="10" y1="11" y2="17" />
                                                                <line x1="14" x2="14" y1="11" y2="17" />
                                                            </svg>
                                                        </button>
                                                    </form>
                                                    <% } %>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } %>

            <!-- Etkinliğe Dön Buton Kutusu (En Altta) -->
            <div style="margin-top: 25px; padding-top: 15px; border-top: 1px solid rgba(15, 56, 44, 0.12);">
                <a href="<%= isSettlementPhase ? '/settlement/' + activity.id : '/activity/' + activity.id %>"
                    style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 13px 18px; background: #ffffff; color: #0f382c; border: 1.5px solid rgba(15, 56, 44, 0.18); border-radius: 14px; font-weight: 600; font-size: 13.5px; text-decoration: none; box-shadow: 0 3px 10px rgba(0, 0, 0, 0.02); transition: all 0.2s ease;"
                    onmouseover="this.style.background='#f4f3ef'; this.style.borderColor='#0f382c';"
                    onmouseout="this.style.background='#ffffff'; this.style.borderColor='rgba(15, 56, 44, 0.18)';">
                    <i class="fas fa-arrow-left" style="font-size: 12px;"></i> Etkinliğe Dön
                </a>
            </div>

        </div>

        <script>
            function showToast(message, isSuccess = true) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                position: fixed; 
                bottom: 30px; 
                left: 50%; 
                transform: translateX(-50%) translateY(20px); 
                background: ${isSuccess ? '#2e7d32' : '#c62828'}; 
                color: white; 
                padding: 12px 24px; 
                border-radius: 30px; 
                font-weight: 600; 
                font-size: 14px; 
                z-index: 999999; 
                box-shadow: 0 4px 12px rgba(15, 56, 44, 0.15); 
                opacity: 0; 
                transition: opacity 0.3s ease, transform 0.3s ease; 
                pointer-events: none; 
                text-align: center;
                white-space: nowrap;
            `;
                toast.textContent = message;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '1';
                    toast.style.transform = 'translateX(-50%) translateY(0)';
                }, 10);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(-50%) translateY(20px)';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            function copyShareLink() {
                const inviteLink = '<%= typeof inviteLink !== "undefined" ? inviteLink : "" %>';
                const linkToCopy = inviteLink || window.location.href;
                navigator.clipboard.writeText(linkToCopy).then(() => {
                    showToast('Paylaşım linki kopyalandı! 🎉');
                }).catch(err => {
                    console.error("Kopyalama hatası:", err);
                    showToast('Link kopyalanamadı!', false);
                });
            }

            function sendReminder(event, form) {
                event.preventDefault();
                const btn = form.querySelector('.btn-remind');
                const originalContent = btn.innerHTML;
                const originalBackground = btn.style.background || '';
                const formData = new URLSearchParams(new FormData(form));

                btn.style.background = '#22c55e';
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

                fetch('/notify-debt', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData.toString()
                }).then(() => {
                    setTimeout(() => {
                        btn.style.background = originalBackground;
                        btn.innerHTML = originalContent;
                    }, 3000);
                }).catch(err => {
                    console.error(err);
                    setTimeout(() => {
                        btn.style.background = originalBackground;
                        btn.innerHTML = originalContent;
                    }, 3000);
                });
            }
        </script>
        <script src="/custom-confirm.js"></script>
    </div>
        <!-- Alt Navigasyon Menüsü -->
        <nav class="bottom-nav">
            <a href="/panel" class="nav-item">
                <i class="fas fa-folder-open"></i>
                <span>Etkinlikler</span>
            </a>
            <a href="/profile" class="nav-item">
                <i class="fas fa-user"></i>
                <span>Profil</span>
            </a>
        </nav>

</body>

</html>