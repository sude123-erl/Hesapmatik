<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Etkinliği Paylaş</title>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #e8e7e1 !important;
            color: #0f382c !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: #f4f3ef;
            padding: 28px 24px;
            border-radius: 20px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 25px rgba(15, 56, 44, 0.06);
            border: 1px solid rgba(15, 56, 44, 0.12);
            text-align: center;
        }

        /* En Üstteki Etkinlik Adı Kutusu */
        .activity-header-box {
            background: rgba(15, 56, 44, 0.08);
            color: #0f382c;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        h2 {
            font-size: 18px;
            font-weight: 700;
            color: #0f382c;
            margin-bottom: 16px;
        }

        /* QR Kod Kutusu */
        .qr-container {
            background: #ffffff;
            border: 1.5px solid rgba(15, 56, 44, 0.15);
            border-radius: 16px;
            padding: 20px;
            display: inline-block;
            margin-bottom: 20px;
        }

        .qr-container img {
            max-width: 180px;
            height: auto;
            display: block;
        }

        /* Paylaş Butonu */
        .btn-share {
            width: 100%;
            padding: 12px;
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .btn-share:hover {
            background: #175241;
        }

        /* Geri Dön Linki */
        .back-link {
            display: inline-block;
            margin-top: 10px;
            margin-bottom: 20px;
            color: #0f382c;
            font-size: 13px;
            font-weight: 600;
            text-decoration: underline;
            cursor: pointer;
        }

        .divider {
            height: 1px;
            background: rgba(15, 56, 44, 0.12);
            margin-bottom: 20px;
        }

        /* Katılımcılar Başlığı ve Rozeti */
        .participants-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .participants-header span {
            font-size: 15px;
            font-weight: 700;
            color: #0f382c;
        }

        .badge-count {
            background: rgba(15, 56, 44, 0.1);
            color: #0f382c;
            font-size: 12px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 12px;
        }

        /* Katılımcı Satırı */
        .participant-box {
            background: #ffffff;
            border: 1px solid rgba(15, 56, 44, 0.15);
            padding: 10px 14px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            margin-bottom: 12px;
            color: #0f382c;
        }

        .participant-role {
            font-size: 12px;
            color: #537066;
        }

        /* Katılımcı Ekle Formu */
        .add-form {
            display: flex;
            gap: 8px;
        }

        .select-participant {
            flex: 1;
            padding: 10px 12px;
            border: 1.5px solid rgba(15, 56, 44, 0.2);
            border-radius: 10px;
            font-size: 13px;
            color: #0f382c;
            background: #ffffff;
            outline: none;
        }

        .btn-add {
            padding: 10px 16px;
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-remind {
            background: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 8px;
            padding: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .btn-remind:hover {
            background: #175241;
        }

        .btn-remove {
            background: #fee2e2;
            color: #ef4444;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .btn-remove:hover {
            background: #fca5a5;
            color: #b91c1c;
        }

        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <div class="card">
        <!-- Etkinlik Adı Kutusu -->
        <div class="activity-header-box">
            <%= typeof activity !=='undefined' ? activity.name : 'Ankara' %>
        </div>

        <h2>Etkinliği Paylaş</h2>

        <% if (isOwner) { %>
            <!-- QR Kod -->
            <div class="qr-container">
                <img src="<%= typeof qrCodeUrl !== 'undefined' ? qrCodeUrl : '/path-to-qr.png' %>" alt="QR Kod">
            </div>

            <!-- Paylaşım Butonu -->
            <button class="btn-share" onclick="copyShareLink()">Linki Kopyala ve Paylaş</button>
            <% } else { %>
                <div
                    style="background: rgba(15, 56, 44, 0.05); padding: 15px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; color: #537066;">
                    Yalnızca etkinlik sahibi yeni kişileri davet edebilir.
                </div>
                <% } %>

                    <div>
                        <a href="javascript:history.back()" class="back-link">← Etkinliğe Dön</a>
                    </div>

                    <div class="divider"></div>

                    <!-- Katılımcılar Alanı -->
                    <div class="participants-header">
                        <span>Katılımcılar</span>
                        <span class="badge-count">
                            <%= participants ? participants.length : 0 %> kişi
                        </span>
                    </div>

                    <% if (participants && participants.length> 0) { %>
                        <% participants.forEach(p=> { %>
                            <div class="participant-box">
                                <div>
                                    <span style="font-weight: 600;">
                                        <%= p.fullname || p.username %>
                                    </span>
                                    <% if (String(activity.creatorId)===String(p.id)) { %>
                                        <span class="participant-role" style="display:block;">Etkinlik sahibi</span>
                                        <% } %>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <% if (typeof currentUserId !=='undefined' && currentUserId && String(currentUserId)
                                        !==String(p.id)) { %>
                                        <!-- Hatırlat Butonu -->
                                        <form action="/notify-debt" method="POST" style="margin: 0;"
                                            onsubmit="sendReminder(event, this)">
                                            <input type="hidden" name="targetUserId" value="<%= p.id %>">
                                            <input type="hidden" name="activityName"
                                                value="<%= activity.activityName %>">
                                            <input type="hidden" name="activityId" value="<%= activity.id %>">
                                            <button type="submit" title="Hatırlat" class="btn-remind">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                                </svg>
                                            </button>
                                        </form>
                                        <% } %>

                                            <% if (String(activity.creatorId) !==String(p.id) && isOwner && !isLocked) {
                                                %>
                                                <!-- Çıkar Butonu -->
                                                <form
                                                    action="/activity/<%= activity.id %>/participants/<%= p.id %>/remove"
                                                    method="POST" style="margin: 0;"
                                                    onsubmit="customConfirm(event, this, 'Bu kişiyi çıkarmak istediğinize emin misiniz?');">
                                                    <button type="submit" title="Çıkar" class="btn-remove">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <path d="M3 6h18" />
                                                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                            <line x1="10" x2="10" y1="11" y2="17" />
                                                            <line x1="14" x2="14" y1="11" y2="17" />
                                                        </svg>
                                                    </button>
                                                </form>
                                                <% } %>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>


    </div>

    <script>
        function copyShareLink() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('Paylaşım linki kopyalandı!');
            });
        }

        function sendReminder(event, form) {
            event.preventDefault();
            const btn = form.querySelector('.btn-remind');
            const originalContent = btn.innerHTML;
            const originalBackground = btn.style.background || '';
            const formData = new URLSearchParams(new FormData(form));

            btn.style.background = '#22c55e';
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

            fetch('/notify-debt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: formData.toString()
            }).then(() => {
                setTimeout(() => {
                    btn.style.background = originalBackground;
                    btn.innerHTML = originalContent;
                }, 3000);
            }).catch(err => {
                console.error(err);
                setTimeout(() => {
                    btn.style.background = originalBackground;
                    btn.innerHTML = originalContent;
                }, 3000);
            });
        }
    </script>
    <script src="/custom-confirm.js"></script>
</body>

</html>