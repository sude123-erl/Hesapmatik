<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifre ve Güvenlik - Hesapmatik</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #e8e7e1 !important;
            color: #0f382c !important;
            padding: 20px;
            padding-bottom: 90px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 440px;
            background: #f4f3ef;
            border: 1px solid rgba(15, 56, 44, 0.12);
            border-radius: 20px;
            padding: 28px 24px;
            box-shadow: 0 10px 25px rgba(15, 56, 44, 0.06);
            position: relative;
        }

        .back-btn {
            text-decoration: none;
            color: #0f382c;
            font-size: 20px;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 15px;
            transition: transform 0.2s ease;
        }

        .back-btn:hover {
            transform: translateX(-3px);
        }

        .title {
            text-align: center;
            font-size: 20px;
            font-weight: 800;
            color: #0f382c;
            margin-bottom: 24px;
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: #537066;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
            margin-bottom: 12px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-weight: 700;
            margin-bottom: 6px;
            font-size: 13px;
            color: #0f382c;
        }

        .form-group input {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid rgba(15, 56, 44, 0.2);
            border-radius: 10px;
            font-size: 14px;
            background: #ffffff;
            color: #0f382c;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .form-group input:focus {
            border-color: #0f382c;
        }

        .divider {
            height: 1px;
            background: rgba(15, 56, 44, 0.12);
            margin: 20px 0;
        }

        .btn-save {
            width: 100%;
            padding: 13px;
            background-color: #0f382c;
            color: #f4f3ef;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s ease;
            margin-top: 10px;
        }

        .btn-save:hover {
            background-color: #175241;
        }
    
    /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
    @media (max-width: 768px) {
        /* Konteynerlar */
        .container, .main-container, .panel-container, .content-container, .form-container, .card, .profile-container, .settings-container {
            width: 95% !important;
            max-width: 100% !important;
            padding: 15px !important;
            margin: 10px auto !important;
            box-sizing: border-box !important;
            box-shadow: none !important;
        }

        /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
        .flex-row, .activities-grid, .list-item, .expense-item, .payment-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 10px !important;
            width: 100% !important;
            height: auto !important;
        }

        

        /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
        input, select, textarea, .btn, .btn-primary, .btn-danger, .btn-secondary {
            width: 100% !important;
            font-size: 16px !important; 
            margin-top: 5px !important;
            margin-bottom: 5px !important;
            box-sizing: border-box !important;
            
        }

        /* Modallar (Acilir Pencereler) */
        .modal-content, #expenseModal > div, #editExpenseModal > div {
            width: 95% !important;
            margin: 20px auto !important;
            padding: 20px !important;
            height: auto !important;
            max-height: 90vh !important;
            overflow-y: auto !important;
        }

        /* Baslik Boyutlari */
        h1, h2 {
            font-size: 1.4rem !important;
            text-align: center !important;
        }
        h3 {
            font-size: 1.2rem !important;
        }

        /* Tablolar (Tasan tablolari kaydirilabilir yap) */
        table {
            display: block !important;
            overflow-x: auto !important;
            white-space: nowrap !important;
            width: 100% !important;
        }
    }

</style>
</head>
<body>

 <div class="container">
    <a href="/profile" class="back-btn">←</a>
    <h2 class="title">Şifre Değiştir</h2>

    <% if (typeof success !== 'undefined' && success) { %>
        <div style="background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; padding: 12px; border-radius: 10px; text-align: center; font-size: 14px; font-weight: 600; margin-bottom: 16px;">
            <%= success %>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 12px; border-radius: 10px; text-align: center; font-size: 14px; font-weight: 600; margin-bottom: 16px;">
            <%= error %>
        </div>
    <% } %>

    <form action="/profile/security" method="POST">
        <div class="form-group">
            <label for="currentPassword">Mevcut Şifre</label>
            <input type="password" id="currentPassword" name="currentPassword" placeholder="Mevcut şifreniz" required>
        </div>

        <div class="form-group">
            <label for="newPassword">Yeni Şifre</label>
            <input type="password" id="newPassword" name="newPassword" placeholder="Yeni şifreniz" required>
        </div>

        <button type="submit" class="btn-save">Şifreyi Güncelle</button>
    </form>
</div>

</body>
</html>