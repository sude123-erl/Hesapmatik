<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hesapmatik - Yeni Şifre Belirleme</title>
    <script src="/theme.js"></script>
    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <div class="login-split-container">
        <!-- Sol Taraf: Tanıtım ve Slogan Alanı -->
        <div class="login-left-panel">
            <div class="brand-header">
                <div class="logo-icon">✨</div>
                <h1>HESAPMATİK</h1>
            </div>

            <div class="hero-text-wrapper">
                <p class="hero-line">Alacak</p>
                <p class="hero-line highlight-green">verecek</p>
                <p class="hero-line">takibinin</p>
                <p class="hero-line highlight-blue">en akıllı yolu</p>
            </div>
            <p class="hero-subtext">Finansal dengenizi saniyeler içinde kontrol altına alın.</p>
        </div>

        <!-- Sağ Taraf: Şifre Yenileme Kartı -->
        <div class="login-right-panel">
            <div class="login-card fade-in">
                <h2>Şifreni Sıfırla</h2>
                <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 25px; text-align: center;">
                    E-postana gelen doğrulama kodunu ve yeni şifreni gir.
                </p>

                <form action="/reset-password" method="POST">
                    <div class="input-group">
                        <label>E-posta Adresin</label>
                        <input type="email" name="email" placeholder="E-posta adresinizi girin" required>
                    </div>

                    <div class="input-group">
                        <label>Doğrulama Kodu</label>
                        <input type="text" name="code" placeholder="E-postadaki 6 haneli kod" required>
                    </div>

                    <div class="input-group">
                        <label>Yeni Şifre</label>
                        <input type="password" name="newPassword" placeholder="Yeni şifrenizi belirleyin" required>
                    </div>

                    <button type="submit" class="btn-login">Şifreyi Güncelle</button>
                </form>

                <div class="login-links" style="justify-content: center; margin-top: 25px;">
                    <a href="/login" class="register-link">← Giriş sayfasına dön</a>
                </div>
            </div>
        </div>
    </div>

</body>

</html>

</html>