<!DOCTYPE html>
<html lang="tr">

<head>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayarlar ve Hareketler - Hesapmatik</title>
    <link rel="stylesheet" href="/theme.css">
    <script src="/theme.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #184e3d !important;
            /* Yazıları net ve belirgin bir koyu yeşile sabitledik */
        }

        body {
            background-color: #e8e7e1 !important;
            padding: 20px;
            padding-bottom: 90px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 440px;
            background: #f4f3ef !important;
            border: 1px solid rgba(24, 78, 61, 0.12);
            border-radius: 20px;
            padding: 28px 24px;
            box-shadow: 0 10px 25px rgba(24, 78, 61, 0.06);
        }

        .user-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(24, 78, 61, 0.1);
        }

        .user-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #184e3d;
        }

        .user-avatar-placeholder {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #f4f3ef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 2px solid #184e3d;
        }

        .title {
            font-size: 20px;
            font-weight: 800;
        }

        .subtitle {
            color: #2e6b56 !important;
            font-weight: 500;
            font-size: 13px;
        }

        .menu-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            font-weight: 700;
            font-size: 15px;
            padding: 12px 10px;
            border-bottom: 1px solid rgba(24, 78, 61, 0.08);
            border-radius: 10px;
            transition: background 0.2s ease, padding-left 0.2s ease;
        }

        .menu-item:hover {
            background: rgba(24, 78, 61, 0.05);
            padding-left: 14px;
        }

        .menu-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* İkonlar Mint Yeşili */
        .menu-item .material-symbols-outlined {
            color: #23745e !important;
            font-size: 22px;
        }

        .menu-item.logout {
            color: #dc2626 !important;
            border-bottom: none;
            margin-top: 8px;
        }

        .menu-item.logout * {
            color: #dc2626 !important;
        }

        .menu-item.logout .material-symbols-outlined {
            color: #dc2626 !important;
        }

        .menu-item.logout:hover {
            background: #fee2e2;
        }

        i,
        .fa,
        .fas,
        .far {
            max-width: 24px;
            max-height: 24px;
            font-size: 20px;
        }

        /* Alt Navigasyon Barı (Dark Green Gradient Theme - Full Width Curved) */
        .bottom-nav {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background: linear-gradient(135deg, #0f382c 0%, #175241 100%) !important;
            color: #ffffff !important;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding: 10px 0;
            border-radius: 16px 16px 0 0;
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 -6px 20px rgba(15, 56, 44, 0.2);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.65) !important;
            font-size: 10.5px;
            font-weight: 500;
            gap: 2px;
            transition: all 0.2s ease;
        }

        .nav-item i,
        .nav-item svg {
            font-size: 18px !important;
            width: 18px !important;
            height: 18px !important;
            max-width: 18px !important;
            max-height: 18px !important;
        }

        .nav-item.active,
        .nav-item:hover {
            color: #ffffff !important;
            font-weight: 700;
            transform: translateY(-1px);
        }

        .editable-field {
            margin-left: 4px;
            cursor: pointer;
            text-decoration: underline;
        }

        /* Fotoğraf Büyütme Modali */
        .image-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            backdrop-filter: blur(5px);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .image-modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .image-modal-content {
            position: relative;
            max-width: 90%;
            max-height: 90%;
        }

        .image-modal-content img {
            width: 100%;
            height: auto;
            max-height: 80vh;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            object-fit: contain;
        }

        .image-modal-close {
            position: absolute;
            top: -40px;
            right: 0;
            color: white !important;
            font-size: 30px;
            cursor: pointer;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        /* --- MOBIL UYUM (RESPONSIVE) EKLENTILERI --- */
        @media (max-width: 768px) {

            /* Konteynerlar */
            .container,
            .main-container,
            .panel-container,
            .content-container,
            .form-container,
            .card,
            .profile-container,
            .settings-container {
                width: 95% !important;
                max-width: 100% !important;
                padding: 15px !important;
                margin: 10px auto !important;
                box-sizing: border-box !important;
                box-shadow: none !important;
            }

            /* Izgaralar ve Yatay Dizilimleri Dikeye Cevirme */
            .flex-row,
            .activities-grid,
            .list-item,
            .expense-item,
            .payment-item {
                display: flex !important;
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px !important;
                width: 100% !important;
                height: auto !important;
            }



            /* Butonlar, Inputlar, Selectler (iOS Zoom engeli icin font-size 16px) */
            input,
            select,
            textarea,
            .btn,
            .btn-primary,
            .btn-danger,
            .btn-secondary {
                width: 100% !important;
                font-size: 16px !important;
                margin-top: 5px !important;
                margin-bottom: 5px !important;
                box-sizing: border-box !important;

            }

            /* Modallar (Acilir Pencereler) */
            .modal-content,
            #expenseModal>div,
            #editExpenseModal>div {
                width: 95% !important;
                margin: 20px auto !important;
                padding: 20px !important;
                height: auto !important;
                max-height: 90vh !important;
                overflow-y: auto !important;
            }

            /* Baslik Boyutlari */
            h1,
            h2 {
                font-size: 1.4rem !important;
                text-align: center !important;
            }

            h3 {
                font-size: 1.2rem !important;
            }

            /* Tablolar (Tasan tablolari kaydirilabilir yap) */
            table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <!-- Kullanıcı Başlık Alanı -->
        <div class="user-header">
            <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" class="user-avatar" alt="Profil" style="cursor: pointer;"
                    onclick="openImageModal()">
                <% } else { %>
                    <div class="user-avatar-placeholder">👤</div>
                    <% } %>
                        <div>
                            <div class="title">
                                <%= user.username %>
                            </div>
                            <div class="subtitle">Ayarlar ve Hareketler</div>
                        </div>
        </div>

        <div class="menu-list">
            <a href="/profile/edit" class="menu-item">
                <div class="menu-left">
                    <span class="material-symbols-outlined">person</span>
                    <span>Profil ve Kullanıcı Adı</span>
                </div>
            </a>

            <a href="/profile/security" class="menu-item">
                <div class="menu-left">
                    <span class="material-symbols-outlined">lock</span>
                    <span>Şifre ve Güvenlik</span>
                </div>
            </a>

            <a href="#" onclick="openLogoutModal(event)" class="menu-item logout">
                <div class="menu-left">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Çıkış Yap</span>
                </div>
            </a>
        </div>
    </div>

    <nav class="bottom-nav">

        <a href="/panel" class="nav-item">
            <i class="fas fa-folder-open"></i>
            <span>Etkinlikler</span>
        </a>
        <a href="/profile" class="nav-item active">
            <i class="fas fa-user"></i>
            <span>Profil</span>
        </a>
    </nav>

    <!-- Fotoğraf Büyütme Modali (HTML) -->
    <% if (user.avatar) { %>
        <div class="image-modal-overlay" id="imageModal" onclick="closeImageModal()">
            <div class="image-modal-content" onclick="event.stopPropagation()">
                <span class="image-modal-close" onclick="closeImageModal()">&times;</span>
                <img src="<%= user.avatar %>" alt="Büyük Profil Fotoğrafı">
            </div>
        </div>
        <% } %>

            <!-- Çıkış Onay Modalı -->
            <div id="logoutModal"
                style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(2px);">
                <div
                    style="background: #f4f3ef; color: #184e3d; padding: 28px; border-radius: 20px; text-align: center; width: 90%; max-width: 340px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid rgba(24, 78, 61, 0.15);">
                    <div style="font-size: 40px; margin-bottom: 15px;">👋</div>
                    <h3 style="margin-bottom: 10px; font-size: 20px; font-weight: 800;">Emin misiniz?</h3>
                    <p style="color: #2e6b56; font-size: 14px; margin-bottom: 24px; font-weight: 500;">Hesabınızdan
                        çıkış yapmak istediğinize emin misiniz?</p>
                    <div style="display: flex; justify-content: center; gap: 12px;">
                        <button onclick="closeLogoutModal()"
                            style="flex: 1; background: #e8e7e1; color: #184e3d; border: 1px solid rgba(24, 78, 61, 0.15); padding: 12px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: background 0.2s;">İptal</button>
                        <button onclick="window.location.href='/logout'"
                            style="flex: 1; background: #dc2626; color: white; border: none; padding: 12px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: background 0.2s;">Çıkış
                            Yap</button>
                    </div>
                </div>
            </div>

            <script>
                function openImageModal() {
                    const modal = document.getElementById('imageModal');
                    if (modal) {
                        modal.classList.add('active');
                    }
                }

                function closeImageModal() {
                    const modal = document.getElementById('imageModal');
                    if (modal) {
                        modal.classList.remove('active');
                    }
                }

                function openLogoutModal(e) {
                    e.preventDefault();
                    document.getElementById('logoutModal').style.display = 'flex';
                }

                function closeLogoutModal() {
                    document.getElementById('logoutModal').style.display = 'none';
                }
            </script>
</body>

</html>