<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
    let cropper;

    function toggleExpenseList() {
        const container = document.getElementById('expenseListContainer');
        if (container.style.display === 'none' || container.style.display === '') {
            container.style.display = 'block';
        } else {
            container.style.display = 'none';
        }
    }

    function openEditExpenseModal(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const amount = btn.getAttribute('data-amount');
        const receipt = btn.getAttribute('data-receipt');

        document.getElementById('editExpenseForm').action = '/edit-expense/' + id;
        document.getElementById('editExpenseName').value = name;
        document.getElementById('editExpenseAmount').value = amount;

        const receiptContainer = document.getElementById('editExpenseReceiptContainer');
        if (receipt) {
            receiptContainer.style.display = 'block';
            document.getElementById('editExpenseReceiptImg').src = receipt.startsWith('http') ? receipt : '/uploads/' + receipt;
        } else {
            receiptContainer.style.display = 'none';
        }

        document.getElementById('editExpenseModal').style.display = 'flex';
    }

    function closeEditExpenseModal() {
        document.getElementById('editExpenseModal').style.display = 'none';
    }

    function openReceiptModal(src) {
        document.getElementById('receiptModalImg').src = src;
        document.getElementById('receiptModal').style.display = 'flex';
    }

    function closeReceiptModal() {
        document.getElementById('receiptModal').style.display = 'none';
    }

    function openPaymentModal() {
        document.getElementById('paymentModal').style.display = 'flex';
    }
    function closePaymentModal() {
        document.getElementById('paymentModal').style.display = 'none';
    }
    function openBalancesModal() {
        document.getElementById('balancesModal').style.display = 'flex';
    }
    function closeBalancesModal() {
        document.getElementById('balancesModal').style.display = 'none';
    }
    function openImageModal() {
        document.getElementById('imageModal').style.display = 'flex';
    }
    function closeImageModal() {
        document.getElementById('imageModal').style.display = 'none';
        // Modalı kapattığımızda değişiklik yapmaktan vazgeçmiş olabilir
    }
    function previewImage(input) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        const previewImage = document.getElementById('imagePreview');
        const uploadLabel = document.getElementById('uploadLabel');
        document.getElementById('removeImageFlag').value = 'false';

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewContainer.style.display = 'block';
                uploadLabel.style.display = 'none';

                if (cropper) {
                    cropper.destroy();
                }

                cropper = new Cropper(previewImage, {
                    aspectRatio: 16 / 9,
                    viewMode: 1,
                    autoCropArea: 1,
                });
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    function confirmCrop() {
        if (cropper) {
            const btnConfirm = event.currentTarget;
            const btnCancel = btnConfirm.nextElementSibling;

            cropper.getCroppedCanvas({
                width: 800,
                height: 450
            }).toBlob(function (blob) {
                const file = new File([blob], "cover.jpg", { type: "image/jpeg" });
                const dt = new DataTransfer();
                dt.items.add(file);
                document.getElementById('coverImage').files = dt.files;

                const previewImage = document.getElementById('imagePreview');
                previewImage.src = URL.createObjectURL(blob);

                cropper.destroy();
                cropper = null;

                btnConfirm.style.display = 'none';
                btnCancel.style.display = 'none';
            }, 'image/jpeg', 0.8);
        }
    }

    function clearImage() {
        const input = document.getElementById('coverImage');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const previewImage = document.getElementById('imagePreview');
        const uploadLabel = document.getElementById('uploadLabel');

        if (cropper) {
            cropper.destroy();
            cropper = null;
        }

        input.value = "";
        previewImage.src = "";
        previewContainer.style.display = 'none';
        uploadLabel.style.display = 'flex';
        document.getElementById('removeImageFlag').value = 'true';
    }

    document.getElementById('activityImageForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const form = this;

        if (cropper) {
            cropper.getCroppedCanvas({
                width: 800,
                height: 450
            }).toBlob(function (blob) {
                const file = new File([blob], "cover.jpg", { type: "image/jpeg" });
                const dt = new DataTransfer();
                dt.items.add(file);
                document.getElementById('coverImage').files = dt.files;
                form.submit();
            }, 'image/jpeg', 0.8);
        } else {
            form.submit();
        }
    });

    document.addEventListener('submit', async function (e) {
        if (e.target && e.target.classList.contains('ajax-delete-expense-form')) {
            e.preventDefault();
            const form = e.target;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        const row = form.closest('.expense-row');
                        if (row) {
                            row.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                            row.style.opacity = '0';
                            row.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                row.remove();
                            }, 300);
                        }
                    } else {
                        window.location.reload();
                    }
                } else {
                    window.location.reload();
                }
            } catch (err) {
                window.location.reload();
            }
        }
    });
    let categoryChartInstance = null;
    function initChart() {
        const canvas = document.getElementById('categoryChart');
        if (!canvas) return;

        if (categoryChartInstance) {
            categoryChartInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        let labels = [];
        let data = [];
        try {
            labels = JSON.parse(canvas.getAttribute('data-labels') || '[]');
            data = JSON.parse(canvas.getAttribute('data-values') || '[]');
        } catch (e) { }

        categoryChartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: [
                        '#ff6384', '#36a2eb', '#ffce56', '#4bc0c0', '#9966ff', '#ff9f40', '#c9cbcf', '#f1c40f', '#e67e22', '#e74c3c'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        onClick: null,
                        labels: { boxWidth: 12, font: { size: 11 } }
                    }
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initChart();
    });
</script>
