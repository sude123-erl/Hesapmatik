<div id="paymentModal"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); z-index: 2000; justify-content: center; align-items: center; overflow-y: auto;">
    <div
        style="background: #f4f3ef; padding: 25px; border-radius: 20px; width: 90%; max-width: 440px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); border: 1px solid rgba(15, 56, 44, 0.15);">
        <div style="margin-bottom: 20px;">
            <h2 style="margin: 0; font-size: 20px; color: #0f382c; font-weight: 800;">Ödeme Ekle</h2>
            <span style="font-size: 14px; font-weight: 600; color: #537066;">
                <%= activityName %>
            </span>
        </div>

        <form action="/add-payment" method="POST">
            <input type="hidden" name="activityId" value="<%= activity.id %>">
            <input type="hidden" name="senderUsername" value="<%= currentUser ? currentUser.username : '' %>">

            <div style="margin-bottom: 16px;">
                <input type="number" step="0.01" max="<%= myDebt > 0 ? myDebt.toFixed(2) : '0' %>"
                    id="paymentAmountInput" name="amount" required placeholder="0,00"
                    style="width: 100%; text-align: center; font-size: 28px; font-weight: 800; padding: 12px; border: 1.5px solid rgba(15, 56, 44, 0.2); border-radius: 12px; outline: none; background: #ffffff; color: #0f382c;">
                <% if (myDebt> 0) { %>
                    <div style="text-align: center; font-size: 12px; color: #537066; margin-top: 6px;">Maksimum
                        ödenebilir tutar: <%= myDebt.toLocaleString('tr-TR', { minimumFractionDigits: 2,
                            maximumFractionDigits: 2 }) %> TL</div>
                    <% } else { %>
                        <div style="text-align: center; font-size: 12px; color: #e74c3c; margin-top: 6px;">Şu an
                            herhangi bir borcunuz bulunmuyor.</div>
                        <% } %>
            </div>

            <div
                style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; border: 1.5px solid rgba(15, 56, 44, 0.2); border-radius: 10px; padding: 8px 12px; background: #ffffff;">
                <span style="font-weight: 700; font-size: 13px; color: #537066;">Ödeme Türü</span>
                <select name="paymentType"
                    style="border: none; font-weight: 700; font-size: 13px; color: #0f382c; outline: none; cursor: pointer; background: transparent;">
                    <option>Nakit</option>
                    <option>Banka Transferi</option>
                </select>
            </div>

            <div style="margin-bottom: 12px;">
                <select name="receiverUsername" required
                    style="width: 100%; padding: 10px 12px; border: 1.5px solid rgba(15, 56, 44, 0.2); border-radius: 10px; font-size: 13px; font-weight: 600; outline: none; color: #0f382c; background: #ffffff; cursor: pointer;">
                    <option value="" disabled selected>Kime gönderdin? (Kişi seçin)</option>
                    <% participants.forEach(participant=> {
                        if (participant.username !== (currentUser ? currentUser.username : '')) {
                        %>
                        <option value="<%= participant.username %>">
                            <%= participant.username %>
                        </option>
                        <% } }); %>
                </select>
            </div>

            <div style="margin-bottom: 20px;">
                <input type="text" id="paymentDescriptionInput" name="description" required
                    placeholder="Ödeme açıklaması girin"
                    style="width: 100%; padding: 10px 12px; border: 1.5px solid rgba(15, 56, 44, 0.2); border-radius: 10px; font-size: 13px; font-weight: 600; outline: none; color: #0f382c; background: #ffffff;">
            </div>

            <div style="display: flex; gap: 10px;">
                <button type="button" onclick="closePaymentModal()"
                    style="flex: 1; background: #e8e7e1; color: #0f382c; border: 1px solid rgba(15, 56, 44, 0.15); padding: 12px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">İptal</button>
                <button type="submit"
                    style="flex: 2; background: <%= myDebt > 0 ? '#0f382c' : '#a0a0a0' %>; color: #f4f3ef; border: none; padding: 12px; border-radius: 12px; font-weight: 700; cursor: <%= myDebt > 0 ? 'pointer' : 'not-allowed' %>; font-size: 14px;"
                    <%=myDebt> 0 ? '' : 'disabled' %>>Ödeme Kaydet</button>
            </div>
        </form>
    </div>
</div>

