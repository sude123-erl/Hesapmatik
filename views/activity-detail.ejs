                <button type="submit"
                    style="flex: 2; background: #0f382c; color: #f4f3ef; border: none; padding: 12px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">Kaydet</button>
            </div>
        </form>
    </div>
</div>


<!-- Sonuç Gör Modali -->
<div id="balancesModal"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); z-index: 2000; justify-content: center; align-items: center;">
    <div
        style="background: #f4f3ef; padding: 25px; border-radius: 16px; width: 90%; max-width: 450px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); border: 1px solid rgba(15, 56, 44, 0.15);">
        <h3 style="color: #0f382c; margin-top: 0; margin-bottom: 20px; font-size: 18px; font-weight: 800;">📊
            Kişisel Borç/Alacak Durumu</h3>

        <% let debtors=[]; let creditors=[]; participants.forEach(p=> {
            // Kişinin kendi yaptığı harcamalar
            let paidExpenses = (allExpenses || []).filter(exp => String(exp.userId) === String(p.id)).reduce((sum,
            exp) => sum + (Number(exp.amount) || 0), 0);
            // Sadece onaylanmış ödemeler
            let sent = payments ? payments.filter(pm => String(pm.senderId) === String(p.id) && pm.status ===
            'approved').reduce((sum, pm) => sum + (Number(pm.amount) || 0), 0) : 0;
            let received = payments ? payments.filter(pm => String(pm.receiverId) === String(p.id) && pm.status ===
            'approved').reduce((sum, pm) => sum + (Number(pm.amount) || 0), 0) : 0;
            let bal = (paidExpenses + sent) - perPersonShare - received;

            bal = Math.round(bal * 100) / 100;

            if (bal < 0) { debtors.push({ id: p.id, fullname: p.fullname, username: p.username, amount: -bal }); } else
                if (bal> 0) {
                creditors.push({ id: p.id, fullname: p.fullname, username: p.username, amount: bal });
                }
                });

                let transactions = [];
                let dIdx = 0;
                let cIdx = 0;

                let tempDebtors = JSON.parse(JSON.stringify(debtors));
                let tempCreditors = JSON.parse(JSON.stringify(creditors));

                while (dIdx < tempDebtors.length && cIdx < tempCreditors.length) { let debtor=tempDebtors[dIdx]; let
                    creditor=tempCreditors[cIdx]; let amount=Math.min(debtor.amount, creditor.amount); if (amount>
                    0.01) {
                    transactions.push({
                    fromId: debtor.id,
                    fromName: debtor.fullname,
                    fromUsername: debtor.username,
                    toId: creditor.id,
                    toName: creditor.fullname,
                    toUsername: creditor.username,
                    amount: amount
                    });
                    }

                    debtor.amount -= amount;
                    creditor.amount -= amount;

                    if (debtor.amount < 0.01) dIdx++; if (creditor.amount < 0.01) cIdx++; } 
                        // Artık sadece giriş yapan kullanıcının değil, tüm işlemler listelenecek 
                        let myTransactions = transactions.filter(t=> t.fromId === currentUserId || t.toId === currentUserId);
                        %>

                        <div style="margin-top: 15px; margin-bottom: 20px;">
                            <% if (transactions.length> 0) { %>
                                <div style="display: flex; flex-direction: column; gap: 12px;">
                                    <% transactions.forEach(t=> { %>
                                        <% if (String(t.fromId)===String(currentUserId)) { %>
                                            <div
                                                style="background: #ffd6d6; border: 1px solid #ff9e9e; border-radius: 12px; padding: 14px; display: flex; align-items: center; gap: 10px;">
                                                <span style="font-size: 20px;">🔴</span>
                                                <p
                                                    style="margin: 0; font-size: 13px; font-weight: 700; color: #0f382c; text-align: left;">
                                                    Sizin <strong>
                                                        <%= t.toName %>
                                                    </strong> (<%= t.toUsername %>) kullanıcısına <strong>
                                                            <%= t.amount.toFixed(2) %> TL
                                                        </strong> borcunuz var.
                                                </p>
                                            </div>
                                            <% } else if (String(t.toId)===String(currentUserId)) { %>
                                                <div
                                                    style="background: #d1f4e0; border: 1px solid #7ce3b1; border-radius: 12px; padding: 14px; display: flex; align-items: center; gap: 10px;">
                                                    <span style="font-size: 20px;">🟢</span>
                                                    <p
                                                        style="margin: 0; font-size: 13px; font-weight: 700; color: #0f382c; text-align: left;">
                                                        <strong>
                                                            <%= t.fromName %>
                                                        </strong> (<%= t.fromUsername %>) size <strong>
                                                                <%= t.amount.toFixed(2) %> TL
                                                            </strong> borçlu.
                                                    </p>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        style="background: #e8e7e1; border: 1px solid rgba(15, 56, 44, 0.15); border-radius: 12px; padding: 14px; display: flex; align-items: center; gap: 10px;">
                                                        <span style="font-size: 20px;">⚪</span>
                                                        <p
                                                            style="margin: 0; font-size: 13px; font-weight: 700; color: #0f382c; text-align: left;">
                                                            <strong>
                                                                <%= t.fromName %>
                                                            </strong>, <strong>
                                                                <%= t.toName %>
                                                            </strong> kullanıcısına <strong>
                                                                <%= t.amount.toFixed(2) %> TL
                                                            </strong> borçlu.
                                                        </p>
                                                    </div>
                                                    <% } %>
                                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <div
                                        style="background: #e8e7e1; border-radius: 12px; padding: 20px; text-align: center; color: #537066; font-weight: 700; font-size: 14px;">
                                        🎉 Etkinlikte henüz kimsenin borcu veya alacağı bulunmuyor!
                                    </div>
                                    <% } %>
                        </div>

