    <div
        style="background: #f4f3ef; padding: 25px; border-radius: 20px; width: 90%; max-width: 440px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); border: 1px solid rgba(15, 56, 44, 0.15);">
